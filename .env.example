# Development defaults. Copy to apps/web/.env.local only if overrides are needed.
AI_CITY_MODE=mock
# Production builds keep local integration APIs disabled unless explicitly set to 1 locally.
AI_CITY_ENABLE_LOCAL_MOCK=0
# Persistent fictional visitors are disabled by default. Use only with the local emulator until approved.
# This feature also requires AI_CITY_ENABLE_LOCAL_MOCK=1 for the manager/device APIs.
AI_CITY_ENABLE_VISITORS=0
# Explicit code-free participation; same origin, server quotas and capacity still apply.
AI_CITY_VISITOR_CODE_FREE=0
# AI_CITY_VISITOR_PROJECT_ID=demo-ai-city
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# AI_CITY_VISITOR_NAMESPACE=your-exhibition
# AI_CITY_VISITOR_HMAC_KEY=<stable-independent-random-server-secret-32-to-256-characters>
# Cloud additionally requires AI_CITY_VISITOR_PROJECT_ID=ai-city-511822, an explicit namespace,
# AI_CITY_VISITOR_ALLOW_CLOUD=1 and approved runtime database/Secret Manager permissions.
# Optional hosted preview. Configure only after deployment approval.
# AI_CITY_PUBLIC_ORIGIN=https://your-approved-preview.example
# AI_CITY_ADMIN_KEY=<server-side-random-secret-32-to-256-characters>
# Never manually set AI_CITY_LOOPBACK_PREVIEW; the local launcher owns that marker.
# Experimental photo intake is disabled. It does not yet connect a real worker or city publication.
# Enable only for an isolated loopback Firestore emulator, with a pre-created, access-restricted
# directory outside the repository. No cloud or hosted-preview environment is accepted.
AI_CITY_SPINE_LOCAL_INTAKE=0
# AI_CITY_SPINE_LOCAL_DIR=<absolute-private-directory-outside-repository>
GOOGLE_CLOUD_PROJECT=ai-city-511822
GOOGLE_CLOUD_QUOTA_PROJECT=ai-city-511822
GOOGLE_CLOUD_LOCATION=asia-northeast1
# Never put service-account JSON, API keys or access tokens in NEXT_PUBLIC_*.
# Fictional-character Vertex AI dialogue is OFF unless explicitly enabled and configured.
# AI_CITY_DIALOGUE_ENABLED=1
# AI_CITY_DIALOGUE_PROJECT=<approved-billing-project>
# AI_CITY_GEMINI_MODEL=gemini-3.1-flash-lite
# AI_CITY_DIALOGUE_MAX_CALLS=20
# Uses server-side ADC and the global Vertex endpoint; no keys in browser code.
# The process-local cap resets on restart and is not a cloud billing limit.
