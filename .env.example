# Development defaults. Copy to apps/web/.env.local only if overrides are needed.
AI_CITY_MODE=mock
# Production builds keep local integration APIs disabled unless explicitly set to 1 locally.
AI_CITY_ENABLE_LOCAL_MOCK=0
# Optional hosted preview. Configure only after deployment approval.
# AI_CITY_PUBLIC_ORIGIN=https://your-approved-preview.example
# AI_CITY_ADMIN_KEY=<server-side-random-secret-32-to-256-characters>
# Never manually set AI_CITY_LOOPBACK_PREVIEW; the local launcher owns that marker.
GOOGLE_CLOUD_PROJECT=ai-city-511822
GOOGLE_CLOUD_QUOTA_PROJECT=ai-city-511822
GOOGLE_CLOUD_LOCATION=asia-northeast1
# Never put service-account JSON, API keys or access tokens in NEXT_PUBLIC_*.
# Live model calls are intentionally not implemented in this foundation.
