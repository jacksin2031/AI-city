{
  "name": "ai-city",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.12.0 <25",
    "pnpm": "11.9.0"
  },
  "scripts": {
    "dev": "pnpm --filter @ai-city/web dev",
    "build": "pnpm --filter @ai-city/web build",
    "start": "pnpm --filter @ai-city/web start",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:rules": "node scripts/emulators.mjs test",
    "emulators": "node scripts/emulators.mjs start",
    "doctor": "node scripts/doctor.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@firebase/rules-unit-testing": "6.0.0",
    "@types/node": "26.6.5",
    "firebase": "13.0.0",
    "firebase-tools": "15.34.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
