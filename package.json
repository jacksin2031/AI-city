{
  "name": "ai-city",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.12.0 <25",
    "pnpm": "11.9.0"
  },
  "scripts": {
    "dialogue:worker": "node scripts/run-dialogue-worker.mjs",
    "spine:preflight-worker": "node scripts/run-spine-preflight.mjs",
    "dev": "pnpm --filter @ai-city/web dev",
    "build": "pnpm --filter @ai-city/web build",
    "start": "pnpm --filter @ai-city/web start",
    "start:remote": "node scripts/start-remote.mjs",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:rules": "node scripts/emulators.mjs test",
    "test:persistence": "node scripts/emulators.mjs persistence",
    "test:visitor:e2e": "node scripts/emulators.mjs visitor-e2e",
    "test:join:e2e": "node scripts/emulators.mjs join-e2e",
    "emulators": "node scripts/emulators.mjs start",
    "doctor": "node scripts/doctor.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@firebase/rules-unit-testing": "6.0.0",
    "@google-cloud/firestore": "9.4.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "firebase": "13.1.0",
    "firebase-tools": "15.34.2",
    "tsx": "4.20.5",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
